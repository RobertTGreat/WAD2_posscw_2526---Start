{{> head}}
{{> header}}

<article class="section prose">
  <h1 class="page-title">Confirm course booking</h1>
  <p class="muted">{{course.title}} · {{course.level}} · {{course.type}}</p>
  <p class="lede">{{course.description}}</p>
  <p class="muted">Runs {{course.startDate}} – {{course.endDate}}</p>

  <section class="stack">
    <h2>Sessions included</h2>
    <ul class="list-plain">
      {{#sessions}}
      <li>{{start}} · {{remaining}} places left</li>
      {{/sessions}}
    </ul>
  </section>

  <form method="post" action="/courses/{{course.id}}/book" class="stack">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <p class="muted">By confirming you agree to our studio health &amp; cancellation policy.</p>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Confirm course booking</button>
      <a class="btn btn-ghost" href="/courses/{{course.id}}">Back</a>
    </div>
  </form>
</article>

{{> footer}}
