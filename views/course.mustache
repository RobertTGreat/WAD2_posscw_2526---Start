{{> head}}
{{> header}}

<article class="section prose">
  <p class="eyebrow">{{course.type}} · {{course.level}}</p>
  <h1 class="page-title">{{course.title}}</h1>
  <p class="muted">Instructor: {{course.instructorName}} · Studio: {{course.location}} · From {{course.defaultPrice}} per class</p>
  <p class="lede">{{course.description}}</p>
  <p class="muted">Course dates: {{course.startDate}} – {{course.endDate}}</p>

  {{#canBook}}
  <section class="stack">
    <h2>Book the full course</h2>
    <p class="muted">Reserves your place for every session in this programme.</p>
    <form method="post" action="/courses/{{course.id}}/book">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <button class="btn btn-primary" type="submit">Book full course</button>
    </form>
    <p><a class="btn btn-secondary" href="/courses/{{course.id}}/book">Review booking page</a></p>
  </section>
  {{/canBook}}
  {{^canBook}}
  <p><a class="btn btn-primary" href="{{loginUrl}}">Sign in to book</a></p>
  {{/canBook}}

  <section class="stack">
    <h2>Classes</h2>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Start</th>
            <th scope="col">End</th>
            <th scope="col">Location</th>
            <th scope="col">Price</th>
            <th scope="col">Places</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          {{#sessions}}
          <tr>
            <td>{{start}}</td>
            <td>{{end}}</td>
            <td>{{location}}</td>
            <td>{{price}}</td>
            <td>{{remaining}} left</td>
            <td>
              {{#../canBook}}
              {{#showDropIn}}
              <form method="post" action="/sessions/{{id}}/book" class="inline-form">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" />
                <button class="btn btn-secondary" type="submit" {{#isFull}}disabled{{/isFull}}>Book class</button>
              </form>
              {{/showDropIn}}
              {{^showDropIn}}
              <span class="muted">Block enrolment</span>
              {{/showDropIn}}
              {{/../canBook}}
              {{^../canBook}}
              <span class="muted">—</span>
              {{/../canBook}}
            </td>
          </tr>
          {{/sessions}}
        </tbody>
      </table>
    </div>
  </section>
</article>

{{> footer}}
