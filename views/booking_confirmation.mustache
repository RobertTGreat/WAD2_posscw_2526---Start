{{> head}}
{{> header}}

<section class="section prose">
  <h1 class="page-title">Booking saved</h1>
  <p class="lede">Thank you — we have recorded your booking.</p>
  <dl class="kv">
    <dt>Reference</dt><dd>{{booking.id}}</dd>
    <dt>Type</dt><dd>{{booking.type}}</dd>
    <dt>Status</dt><dd>{{booking.status}}</dd>
    <dt>Created</dt><dd>{{booking.createdAt}}</dd>
  </dl>
  <p class="actions">
    <a class="btn btn-primary" href="/courses">Browse more courses</a>
  </p>
</section>

{{> footer}}
