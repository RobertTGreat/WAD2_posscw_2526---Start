{{> head}}
{{> header}}

<section class="hero">
  <p class="eyebrow">Yoga &amp; mindfulness</p>
  <h1>Upcoming courses</h1>
  <p class="lede">Quiet, focused scheduling for our Glasgow studio. Browse upcoming courses and book when you are ready.</p>
  <p><a class="btn btn-primary" href="/courses">View all courses</a></p>
</section>

<section class="section">
  <h2 class="section-title">Upcoming</h2>
  <div class="cards">
    {{#courses}}
    <article class="card">
      <h3 class="card-title"><a href="/courses/{{id}}">{{title}}</a></h3>
      <p class="muted small">{{level}} · {{location}} · {{price}}</p>
      <p class="card-desc">{{description}}</p>
      <p class="muted small">Next: {{nextSession}} · {{sessionsCount}} sessions</p>
      <p class="card-actions"><a class="btn btn-secondary" href="/courses/{{id}}">Details</a></p>
    </article>
    {{/courses}}
    {{^courses}}
    <p class="muted">No upcoming courses right now. Check back soon.</p>
    {{/courses}}
  </div>
</section>

{{> footer}}
