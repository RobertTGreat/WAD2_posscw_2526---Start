{{> head}}
{{> header}}

<section class="section narrow">
  <h1 class="page-title">{{title}}</h1>
  {{#error}}
  <p class="alert" role="alert">{{error}}</p>
  {{/error}}
  <form class="stack form" method="post" action="/organiser/courses/{{course._id}}">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label>Title <input name="title" required value="{{course.title}}" /></label>
    <label>Level
      <select name="level" required>
        <option value="beginner" {{#sel.beginner}}selected{{/sel.beginner}}>Beginner</option>
        <option value="intermediate" {{#sel.intermediate}}selected{{/sel.intermediate}}>Intermediate</option>
        <option value="advanced" {{#sel.advanced}}selected{{/sel.advanced}}>Advanced</option>
      </select>
    </label>
    <label>Format
      <select name="type" required>
        <option value="WEEKLY_BLOCK" {{#sel.weekly}}selected{{/sel.weekly}}>Weekly block</option>
        <option value="WEEKEND_WORKSHOP" {{#sel.weekend}}selected{{/sel.weekend}}>Weekend workshop</option>
      </select>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="allowDropIn" value="true" {{#course.allowDropIn}}checked{{/course.allowDropIn}} />
      Allow drop-in bookings for single classes
    </label>
    <label>Studio location <input name="location" required value="{{course.location}}" /></label>
    <label>Default price per class (£) <input name="defaultPriceGbp" type="text" required value="{{course.defaultPriceGbp}}" /></label>
    <label>Start date <input name="startDate" type="date" required value="{{course.startDate}}" /></label>
    <label>End date <input name="endDate" type="date" required value="{{course.endDate}}" /></label>
    <label>Instructor name <input name="instructorName" value="{{course.instructorName}}" /></label>
    <label>Description <textarea name="description" rows="5" required>{{course.description}}</textarea></label>
    <button class="btn btn-primary" type="submit">Update course</button>
  </form>

  <form class="danger-zone" method="post" action="/organiser/courses/{{course._id}}/delete" onsubmit="return confirm('Delete this course and all its classes?');">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <button class="btn btn-danger" type="submit">Delete course</button>
  </form>
</section>

<section class="section">
  <h2>Classes</h2>
  <p><a class="btn btn-secondary" href="/organiser/courses/{{course._id}}/sessions/new">Add class session</a></p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Start</th><th>End</th><th>Capacity</th><th>Booked</th><th></th></tr>
      </thead>
      <tbody>
        {{#sessions}}
        <tr>
          <td>{{start}}</td>
          <td>{{end}}</td>
          <td>{{capacity}}</td>
          <td>{{booked}}</td>
          <td class="nowrap">
            <a href="/organiser/sessions/{{id}}/participants">Roster</a>
            ·
            <a href="/organiser/sessions/{{id}}/edit">Edit</a>
            ·
            <form class="inline-form" method="post" action="/organiser/sessions/{{id}}/delete" onsubmit="return confirm('Delete this class?');">
              <input type="hidden" name="_csrf" value="{{csrfToken}}" />
              <button type="submit" class="link-btn">Delete</button>
            </form>
          </td>
        </tr>
        {{/sessions}}
        {{^sessions}}
        <tr><td colspan="5" class="muted">No sessions yet.</td></tr>
        {{/sessions}}
      </tbody>
    </table>
  </div>
</section>

{{> footer}}
